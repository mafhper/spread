---
/**
 * StaticHero - Versão estática (Astro) do Hero para First Contentful Paint instantâneo.
 * Esta versão não possui lógica React e serve como "placeholder" visual enquanto o bundle carrega.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<section
  class="relative min-h-screen flex flex-col items-center justify-start sm:justify-center pt-24 pb-12 sm:py-0 px-4 sm:px-6 lg:px-8 overflow-hidden"
  style="min-height: 100dvh"
>
  <!-- Background Static Shell -->
  <div class="absolute inset-0">
    <div
      class="absolute inset-0 bg-gradient-to-b from-zinc-950 via-zinc-900 to-zinc-950"
    >
    </div>
    <!-- Orbs estáticos (sem animação pesada no primeiro frame) -->
    <div
      class="absolute top-[-20%] left-[-15%] w-[60%] h-[60%] bg-violet-600/10 rounded-full blur-[120px]"
    >
    </div>
    <div
      class="absolute bottom-[-15%] right-[-10%] w-[55%] h-[55%] bg-fuchsia-600/10 rounded-full blur-[120px]"
    >
    </div>
  </div>

  <!-- Content Static Shell -->
  <div
    class="relative z-10 flex flex-col items-center text-center max-w-4xl mx-auto w-full"
  >
    <!-- Static Logo -->
    <div class="relative mb-6 sm:mb-12">
      <div class="relative w-24 h-24 sm:w-36 sm:h-36">
        <div
          class="absolute inset-0 bg-gradient-to-tr from-violet-500 via-fuchsia-500 to-pink-500 rounded-3xl rotate-6 opacity-80"
        >
        </div>
        <div
          class="absolute inset-1 bg-zinc-950 rounded-3xl flex items-center justify-center"
        >
          <img
            src={`${base}/logo.svg`}
            alt="Spread"
            class="w-12 h-12 sm:w-20 sm:h-20"
            style="filter: brightness(1.3) contrast(1.1)"
            fetchpriority="high"
            loading="eager"
          />
        </div>
      </div>
    </div>

    <!-- Static Headline -->
    <div
      class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tight mb-3 sm:mb-6 text-white"
    >
      <span
        class="bg-clip-text text-transparent bg-gradient-to-b from-white via-white to-white/50"
      >
        Spread
      </span>
    </div>

    <!-- Static Tagline -->
    <p
      class="text-base sm:text-xl md:text-2xl text-white/60 font-medium max-w-2xl mb-8 sm:mb-12 leading-relaxed px-4"
    >
      Crie visualizações <span class="text-white/90">elegantes</span> de links para
      compartilhar nas redes sociais
    </p>

    <!-- Static Input Placeholder -->
    <div class="w-full max-w-2xl px-2 opacity-50 pointer-events-none">
      <div
        class="flex flex-col sm:flex-row gap-2 sm:gap-3 rounded-2xl p-1.5 sm:p-2 bg-white/5 border border-white/10 ring-1 ring-white/5 animate-pulse"
      >
        <div class="flex-1 px-4 sm:px-6 py-3 sm:py-4 h-[52px]"></div>
        <div class="w-full sm:w-32 bg-white/10 rounded-xl h-[52px]"></div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Mantendo consistência com o visual do React */
  .bg-clip-text {
    -webkit-background-clip: text;
    background-clip: text;
  }
</style>
