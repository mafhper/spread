---
/**
 * Página 404 - Não Encontrado
 */

const base = import.meta.env.BASE_URL
const normalizedBase = base.endsWith('/') ? base.slice(0, -1) : base
---

<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Página não encontrada - Spread" />
    <title>404 - Página Não Encontrada | Spread</title>
    <meta name="robots" content="noindex, nofollow" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${normalizedBase}/favicon-light.svg`}
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${normalizedBase}/favicon-dark.svg`}
      media="(prefers-color-scheme: dark)"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family:
          'Inter',
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
        background-color: #09090b;
        color: #f4f4f5;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .container {
        text-align: center;
        padding: 2rem;
        max-width: 480px;
      }
      .logo {
        width: 64px;
        height: 64px;
        margin: 0 auto 2rem;
        background: linear-gradient(135deg, #c084fc 0%, #f472b6 100%);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 20px 40px -10px rgba(192, 132, 252, 0.3);
      }
      .logo img {
        width: 36px;
        height: 36px;
        filter: invert(1);
      }
      .error-code {
        font-size: 8rem;
        font-weight: 800;
        line-height: 1;
        background: linear-gradient(135deg, #c084fc 0%, #f472b6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 1rem;
        opacity: 0.8;
      }
      .title {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
        color: #f4f4f5;
      }
      .description {
        font-size: 1rem;
        color: #a1a1aa;
        margin-bottom: 2rem;
        line-height: 1.6;
      }
      .actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.875rem 1.5rem;
        border-radius: 12px;
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s ease;
        cursor: pointer;
        border: none;
      }
      .btn-primary {
        background: linear-gradient(135deg, #c084fc 0%, #f472b6 100%);
        color: white;
      }
      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px -10px rgba(192, 132, 252, 0.4);
      }
      .btn-secondary {
        background: #18181b;
        color: #f4f4f5;
        border: 1px solid #3f3f46;
      }
      .btn-secondary:hover {
        background: #27272a;
        border-color: #52525b;
      }
      @media (max-width: 480px) {
        .error-code {
          font-size: 6rem;
        }
        .title {
          font-size: 1.25rem;
        }
        .actions {
          flex-direction: column;
        }
        .btn {
          width: 100%;
          justify-content: center;
        }
      }
    </style>
  </head>
  <body>
    <main class="container">
      <div class="logo">
        <img src={`${normalizedBase}/logo.svg`} alt="Spread" />
      </div>
      <h1 class="error-code">404</h1>
      <h2 class="title">Página não encontrada</h2>
      <p class="description">
        Oops! Parece que você se perdeu. A página que você está procurando não
        existe ou foi movida.
      </p>
      <div class="actions">
        <a href={normalizedBase} class="btn btn-primary">Voltar ao Início</a>
        <button onclick="history.back()" class="btn btn-secondary"
          >Voltar Atrás</button
        >
      </div>
    </main>
  </body>
</html>
