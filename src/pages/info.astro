---
/**
 * Página de Informações do Spread
 * Contém detalhes sobre recursos, tecnologia, autor e projetos.
 */
import '../styles/global.css'
import { InfoPage as InfoPageComponent } from '../components/landing/InfoPage'

const base = import.meta.env.BASE_URL
---

<!doctype html>
<html lang="pt-br" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Saiba mais sobre o Spread - Recursos, Tecnologias e Desenvolvimento Open Source."
    />
    <title>Spread - Sobre o Projeto</title>
    <meta name="robots" content="index, follow" />
    <link rel="sitemap" href="/spread/sitemap-index.xml" />
    
    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Icons -->
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${base.replace(/\/$/, '')}/favicon-light.svg`}
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${base.replace(/\/$/, '')}/favicon-dark.svg`}
      media="(prefers-color-scheme: dark)"
    />

    <!-- Fonts -->
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      as="style"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />

    <style is:inline>
      :root {
        --bg-main: #09090b;
        --bg-sidebar: #18181b;
        --bg-card: #27272a;
        --bg-input: #3f3f46;
        --border-color: #3f3f46;
        --border-hover: #52525b;
        --text-main: #f4f4f5;
        --text-muted: #a1a1aa;
        --accent-primary: #c084fc;
        --accent-hover: #d8b4fe;
        --accent-gradient: linear-gradient(135deg, #c084fc 0%, #f472b6 100%);
      }
      body {
        font-family: 'Inter', sans-serif;
        background-color: var(--bg-main);
        color: var(--text-main);
        margin: 0;
      }
    </style>
  </head>
  <body class="bg-zinc-950 overflow-x-hidden">
    <InfoPageComponent client:load />
  </body>
</html>
