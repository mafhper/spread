---
import '../styles/global.css'
import { LandingApp } from '../features/studio/LandingApp'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<!doctype html>
<html lang="pt-BR" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Transforme links em cards visuais ajustáveis e exporte PNGs fiéis ao preview."
    />
    <title>Spread — Composição visual para links</title>
    <link rel="canonical" href="https://mafhper.github.io/spread/" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon-dark.svg`} />
  </head>
  <body>
    <LandingApp client:load />
  </body>
</html>
