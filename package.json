{
  "name": "spread",
  "type": "module",
  "version": "1.0.0",
  "description": "Crie visualizações elegantes de links com customização completa",
  "author": "mafhper",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mafhper/spread.git"
  },
  "homepage": "https://mafhper.github.io/spread/",
  "keywords": [
    "link-preview",
    "card-generator",
    "open-graph",
    "music-card",
    "astro",
    "tailwindcss"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "astro": "astro",
    "prepare": "husky",
    "dev": "astro dev",
    "dev:safe": "bun run quality:full && bun run dev",
    "preview": "astro build && vite preview --base=/spread",
    "build": "astro build",
    "build:analyze": "cross-env ANALYZE=true astro build",
    "build:prod": "bun run quality:full && bun run build",
    "test": "cd quality-core && vitest run",
    "test:core": "cd quality-core && vitest run",
    "test:coverage": "cd quality-core && vitest run --coverage",
    "test:watch": "cd quality-core && vitest",
    "test:unit": "cd quality-core && vitest run --testNamePattern 'unit'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "security:audit": "bun audit",
    "quality:core": "node quality-core/cli/quality.cjs",
    "quality:core:quick": "node quality-core/cli/quality.cjs --quick",
    "quality:lighthouse": "node quality-core/cli/run-lighthouse.cjs",
    "quality:snapshot": "bun quality-core/generate-snapshot.ts",
    "quality:dashboard": "bun quality-core/dashboard-server.ts",
    "quality:gate": "node quality-core/cli/run.cjs",
    "quality:gate:quick": "node quality-core/cli/run.cjs --quick",
    "analysis": "node quality-core/cli/run-analysis.cjs",
    "analysis:bundle": "node quality-core/cli/run-analysis.cjs",
    "quality:check": "run-p lint type-check format:check test security:audit",
    "quality:full": "rimraf dist && run-p lint type-check format:check test:core quality:core",
    "quality:reports:all": "bun run quality:core && bun run quality:lighthouse && bun run quality:snapshot && bun run analysis",
    "quality:ci": "bun run quality:full && bun run quality:reports:all"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.0",
    "astro": "^5.17.1",
    "clsx": "^2.1.1",
    "colorthief": "^2.6.0",
    "downloadjs": "^1.4.7",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "web-vitals": "^5.1.0",
    "zustand": "^5.0.10"
  },
  "resolutions": {
    "tmp": "0.2.5",
    "glob": "^11.0.0",
    "lodash": "^4.17.21",
    "@remix-run/router": "^1.23.1"
  },
  "overrides": {
    "tmp": "0.2.5",
    "glob": "^11.0.0",
    "lodash": "^4.17.21",
    "@remix-run/router": "^1.23.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "git add"
    ],
    "*.{json,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitest/coverage-v8": "^4.0.18",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lighthouse": "^12.5.1",
    "lint-staged": "^16.2.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^4.1.18",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.0.18"
  }
}
