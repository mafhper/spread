{
  "name": "spread",
  "type": "module",
  "version": "1.0.0",
  "description": "Crie visualizações elegantes de links com customização completa",
  "author": "mafhper",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mafhper/spread.git"
  },
  "homepage": "https://mafhper.github.io/spread/",
  "keywords": [
    "link-preview",
    "card-generator",
    "open-graph",
    "music-card",
    "astro",
    "tailwindcss"
  ],
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "astro": "astro",
    "prepare": "husky",
    "dev": "astro dev",
    "dev:safe": "run-s check dev",
    "preview": "astro preview",
    "preview:serve": "astro preview",
    "build": "astro build",
    "build:analyze": "cross-env ANALYZE=true astro build",
    "build:prod": "run-s build build:prod:checks",
    "build:prod:checks": "run-p lint type-check format:check test:core security:audit",
    "test": "vitest run",
    "test:core": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:unit": "vitest run --testNamePattern=unit",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "security:audit": "npm audit --audit-level=high --omit=dev --omit=optional",
    "security:update:root": "bun install",
    "security:update": "run-s security:update:root",
    "check": "run-p lint type-check format:check test:core",
    "preflight:github": "run-s type-check lint format:check test:coverage security:audit",
    "clean:dist": "rimraf dist",
    "validate": "run-s clean:dist build check security:audit"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.3",
    "clsx": "^2.1.1",
    "colorthief": "^3.4.0",
    "downloadjs": "^1.4.7",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.562.0",
    "postcss": "^8.5.18",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0",
    "web-vitals": "^5.2.0",
    "zustand": "^5.0.12"
  },
  "resolutions": {
    "shell-quote": "^1.10.0",
    "qs": "^6.15.2",
    "express": "^4.22.2",
    "body-parser": "^1.20.5",
    "tmp": "0.2.7",
    "undici": "7.29.0",
    "esbuild": "0.28.1",
    "glob": "^11.0.0",
    "flatted": "^3.4.2",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "path-to-regexp": "0.1.13",
    "h3": "^1.15.8",
    "js-yaml": "^4.3.1",
    "yaml": "^2.8.3",
    "@remix-run/router": "^1.23.1",
    "basic-ftp": "6.0.1",
    "browserslist": "^4.28.9",
    "@humanfs/node": "^0.16.8",
    "nanoid": "^3.3.18",
    "postcss-selector-parser": "^7.1.5",
    "fast-uri": "3.1.6",
    "ip-address": "10.2.0",
    "uuid": "14.0.0",
    "svgo": "4.0.2"
  },
  "overrides": {
    "shell-quote": "^1.10.0",
    "qs": "^6.15.2",
    "express": "^4.22.2",
    "body-parser": "^1.20.5",
    "tmp": "0.2.7",
    "undici": "7.29.0",
    "esbuild": "0.28.1",
    "glob": "^11.0.0",
    "flatted": "^3.4.2",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "path-to-regexp": "0.1.13",
    "h3": "^1.15.8",
    "js-yaml": "^4.3.1",
    "yaml": "^2.8.3",
    "@remix-run/router": "^1.23.1",
    "basic-ftp": "6.0.1",
    "browserslist": "^4.28.9",
    "@humanfs/node": "^0.16.8",
    "nanoid": "^3.3.18",
    "postcss-selector-parser": "^7.1.5",
    "fast-uri": "3.1.6",
    "ip-address": "10.2.0",
    "uuid": "14.0.0",
    "svgo": "4.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "git add"
    ],
    "*.{json,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-istanbul": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^5.14.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  }
}
